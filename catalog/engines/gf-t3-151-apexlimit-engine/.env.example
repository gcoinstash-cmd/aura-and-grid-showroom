# ==============================================================================
# GF-T3-151 // APEXLIMIT ORDER MATCHING & RISK ENGINE — ENVIRONMENT TEMPLATE
# Clean-Room Certified: Zero Hardcoded Secrets | Strict .env Separation
# ==============================================================================

# 1. Server & Runtime Configuration
PORT=8080
HOST=0.0.0.0
APP_ENV=development
LOG_LEVEL=INFO

# 2. Deterministic Engine & Risk Parameters
PRECISION_SCALE=100000000
DEFAULT_INITIAL_MARGIN_BPS=1000
DEFAULT_MAINTENANCE_MARGIN_BPS=500
DEFAULT_MARKET_SYMBOL=BTC-USD

# 3. Optional Persistent Audit Ledger (PostgreSQL / AlloyDB / Supabase RLS)
# Leave blank for zero-dependency in-memory reference mode
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME_LOCAL_ONLY@localhost:5432/apexlimit_audit

# 4. API Gateway CORS & Security
CORS_ALLOWED_ORIGINS=*
API_KEY_HEADER_NAME=X-ApexLimit-Key
