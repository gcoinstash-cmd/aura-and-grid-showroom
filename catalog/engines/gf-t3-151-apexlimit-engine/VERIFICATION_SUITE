#!/usr/bin/env bash
# ==============================================================================
# VERIFICATION_SUITE — Turnkey Offline Pytest & Coverage Runner (GF-T3-151)
# Zero External Network Dependencies | Enforces >80% Code Coverage Threshold
# ==============================================================================
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "${SCRIPT_DIR}"

echo "======================================================================"
echo " GF-T3-151 // APEXLIMIT ENGINE — OFFLINE VERIFICATION SUITE"
echo " Mode: 100% Mocked / In-Memory Fixtures (Zero Network Calls)"
echo " Gate: Minimum 80% Code Coverage Required"
echo "======================================================================"

if [ -x "../../T3-NEXUS-ORDERBOOK/.venv/bin/pytest" ]; then
    PYTEST_BIN="../../T3-NEXUS-ORDERBOOK/.venv/bin/pytest"
elif command -v pytest >/dev/null 2>&1; then
    PYTEST_BIN="pytest"
else
    echo "Error: pytest not found in PATH or local virtual environment." >&2
    exit 1
fi

PYTHONPATH="${SCRIPT_DIR}" "${PYTEST_BIN}" tests/ \
    --cov=src \
    --cov-report=term-missing \
    --cov-fail-under=80 \
    -v
