{
  "name": "aura-and-grid-storefront-engine",
  "version": "1.2.0-diligence-cleared",
  "description": "Storefront Engine for Aura & Grid - Digital architecture and web templates",
  "type": "module",
  "scripts": {
    "audit:demos": "node scripts/audit_fleet_demos.mjs --strict",
    "audit:vault": "node scripts/audit_fleet_demos.mjs --strict",
    "audit:commercial": "node scripts/site/build_commercial_showroom.mjs --check",
    "export:pdf": "node scripts/site/export_one_pager_pdf.mjs",
    "build": "node scripts/site/build_commercial_showroom.mjs",
    "build:commercial": "node scripts/site/build_commercial_showroom.mjs",
    "build:vault": "node scripts/site/build_public_showroom.mjs && npm run audit:vault && mkdir -p dist && cp -r site/* dist/",
    "sync:master": "node scripts/sync_master.mjs",
    "sync:watch": "node scripts/sync_master.mjs --watch",
    "verify:diligence": "node scripts/verify_diligence_build.mjs",
    "publish:draft": "node scripts/publish-gumroad.mjs --draft",
    "publish:live": "node scripts/publish-gumroad.mjs --live"
  },
  "keywords": [
    "gumroad",
    "templates",
    "storefront"
  ],
  "author": "Aura & Grid",
  "license": "UNLICENSED",
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "playwright": "^1.63.0"
  },
  "dependencies": {
    "@google/genai": "^2.27.0",
    "sharp": "^0.35.5"
  }
}
